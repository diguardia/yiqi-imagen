{
  "name": "yiqi-imagen",
  "version": "1.2.7.11",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@yiqi/docs",
    "build": "npm run build --workspace=@yiqi/ui && npm run build --workspace=@yiqi/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:detail-navigation": "node scripts/check-detail-navigation.js",
    "test:consumer-css": "node scripts/check-consumer-css.js",
    "test:consumer-css:react": "node scripts/check-consumer-css.js apps/docs/app packages/ui/src",
    "test:clases-ds": "node scripts/check-clases-ds.js",
    "test:clases-ds:react": "node scripts/check-clases-ds.js packages/ui --solo-errores",
    "test:clases-ds:legacy": "node scripts/check-clases-ds.js . --solo-errores --sin-fallo",
    "test:e2e": "playwright test",
    "test": "node scripts/check-detail-navigation.js && node scripts/check-consumer-css.js && npm run test:consumer-css:react && npm run test:clases-ds:react && npm run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "typescript": "^6.0.3"
  }
}
